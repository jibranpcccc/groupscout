# ------------------------------------------------------------------
# StudyScout — exam-prep community directory environment template
# Copy to `.env` for local development (never commit `.env`).
# ------------------------------------------------------------------

# Public site URL used for canonical URLs, sitemap and robots.txt.
# On Netlify set this to the production domain, e.g. https://example.com
PUBLIC_SITE_URL=

# Gemini API key — only needed for `npm run discover`.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model used for discovery/classification. Must be a current
# GA model name supported by the Gemini API at the time you run it.
# The lite default is free-tier friendly and reliable for structured output.
GEMINI_MODEL=gemini-3.5-flash-lite

# Whether Gemini is allowed to use Google Search grounding for discovery.
# NOTE: search grounding is quota-blocked on most free-tier Gemini keys.
GEMINI_SEARCH_ENABLED=true

# FREE SEARCH PROVIDERS (recommended for free-tier operation) — set ANY ONE:
#
# Option A — Brave Search API: free tier 2,000 queries/month (~66/day), 1 req/sec.
#   Get a key at https://brave.com/search/api/
# Option B — Tavily: free tier historically 1,000 searches/month, email signup,
#   no credit card. Get a key at https://tavily.com/
#
# With either key set, `npm run discover` searches the real web for candidate
# community URLs; Gemini (free tier) then classifies them. Perfect for
# 10-30 searches per day. Also add the same key as a GitHub secret
# (BRAVE_API_KEY or TAVILY_API_KEY) for the daily scheduled discovery run.
BRAVE_API_KEY=
TAVILY_API_KEY=

# Discovery budget controls (see src/config/discovery.ts)
# ~25 queries/day ≈ 750 Tavily credits/month (free tier is 1,000/mo).
# Distinct query texts searched per run. Generation is study-niche:
# exam × platform × modifier queries with a tiered budget — high-priority
# exams ≈ 70%, secondary exams ≈ 20%, experimental/general-study ≈ 10% —
# interleaved round-robin across exams AND platforms (Discord/Telegram ≈
# 40% each, WhatsApp ≈ 20%), capped per exam so no single exam dominates.
DISCOVERY_MAX_SEARCH_QUERIES=25
# Hard cap on total provider requests per run (distinct queries × providers,
# e.g. 25 queries × 3 providers = 75 requests).
DISCOVERY_MAX_PROVIDER_REQUESTS=75
DISCOVERY_MAX_QUERIES=25
DISCOVERY_MAX_CANDIDATES=120
DISCOVERY_MAX_CANDIDATES_PER_QUERY=10
DISCOVERY_REQUEST_DELAY_MS=1200

# Exam-risk screening (scripts/safety/examRiskClassifier.ts):
# candidates whose evidence contains high-risk exam-fraud language (leaked
# questions, real dumps, braindumps, proxy test takers, bought certificates)
# are auto-REJECTED and logged to src/data/rejected-candidates.json — never
# pending. Risk-flagged language (answer keys, "exam leak") lands in pending
# with safetyFlags: ["exam-risk-language"] for human review. Non-exam-study
# communities (relevance=false) are rejected to the same log as 'wrong-niche'.
# Rejected log is an operational record, never rendered or published.

# Gated auto-publish (manual use only during observation phase): max
# listings auto-approved per run. Gates (all must pass): production guard,
# vertical 'study-prep', linkStatus 'active' (never unknown), fresh
# lastCheckedAt, independent source, no safety flags, classified, exam/cert
# intent confirmed, sourced, no scam indicators. Everything else stays pending.
AUTO_APPROVE_MAX=30

# Freshness window for lastCheckedAt before a pending record is eligible for
# auto-approval (hours). Default 168 = 7 days. Revalidate before publishing
# candidates older than this.
AUTO_APPROVE_FRESHNESS_HOURS=168

# When true, newly discovered communities are published directly to
# groups.json instead of pending-groups.json. Keep false during the 7-day
# observation phase — discovery is pending-only.
AUTO_PUBLISH_DISCOVERED=false

# Link validation controls (see src/config/discovery.ts)
VALIDATE_DELAY_MS=1500
VALIDATE_MAX_CHECKS=200
VALIDATE_REQUEST_TIMEOUT_MS=12000

# Optional: show non-functional ad placeholder boxes while designing.
# Default false — the site should look complete without advertising.
SHOW_AD_PLACEHOLDERS=false
