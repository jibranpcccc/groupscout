---
import type { Community } from '../types/community';
import PlatformBadge from './PlatformBadge.astro';
import CategoryBadge from './CategoryBadge.astro';
import StatusBadge from './StatusBadge.astro';
import VerificationBadge from './VerificationBadge.astro';
import { formatDate } from '../lib/dates';

interface Props {
  community: Community;
}

const { community } = Astro.props;
const checked = formatDate(community.lastCheckedAt);
---

<article class="card flex flex-col p-5 transition-shadow hover:shadow-md">
  <div class="flex items-start justify-between gap-3">
    <PlatformBadge platform={community.platform} />
    <div class="flex items-center gap-1.5">
      <VerificationBadge status={community.verificationStatus} />
      {community.featured && (
        <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700">
          Featured
        </span>
      )}
    </div>
  </div>

  <h2 class="mt-3 text-lg font-semibold leading-snug text-stone-900">
    <a
      href={`/group/${community.slug}/`}
      class="hover:text-blue-700 focus-visible:rounded"
    >
      {community.title}
    </a>
  </h2>

  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-stone-600">
    {community.description ??
      `A publicly listed ${community.platform} community categorized under ${
        community.category
      }.`}
  </p>

  <div class="mt-3 flex flex-wrap items-center gap-1.5">
    <CategoryBadge slug={community.category} />
    {
      community.tags.slice(0, 3).map((tag) => (
        <span
          class="rounded-full border border-stone-200 bg-stone-50 px-2.5 py-0.5 text-xs font-medium text-stone-600"
        >
          {tag}
        </span>
      ))
    }
  </div>

  <dl class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs text-stone-500">
    {
      community.memberCount != null && (
        <div class="flex items-center gap-1">
          <dt class="sr-only">Member count</dt>
          <dd class="font-medium text-stone-700">
            {community.memberCount.toLocaleString()} members
          </dd>
        </div>
      )
    }
    {
      checked && (
        <div class="flex items-center gap-1">
          <dt class="sr-only">Last checked</dt>
          <dd>Last checked {checked}</dd>
        </div>
      )
    }
    <div class="flex items-center gap-1">
      <dt class="sr-only">Link status</dt>
      <dd><StatusBadge status={community.linkStatus} /></dd>
    </div>
  </dl>

  <div class="mt-4 flex items-center gap-2 border-t border-stone-100 pt-4">
    <a
      href={`/group/${community.slug}/`}
      class="btn-secondary px-3 py-1.5 text-xs"
      aria-label={`View details for ${community.title}`}
    >
      View Details
    </a>
    <a
      href={community.inviteUrl}
      target="_blank"
      rel="nofollow ugc noopener noreferrer"
      class="btn-primary px-3 py-1.5 text-xs"
    >
      Visit Community
      <svg viewBox="0 0 20 20" fill="currentColor" class="size-3.5" aria-hidden="true">
        <path d="M11 3a1 1 0 1 0 0 2h2.59l-9.3 9.3a1 1 0 1 0 1.42 1.4L15 6.42V9a1 1 0 1 0 2 0V4a1 1 0 0 0-1-1h-5z" />
      </svg>
    </a>
  </div>
</article>
