---
import { siteConfig } from '../config/site';
---

<footer class="mt-16 border-t border-stone-200 bg-surface">
  <div class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="text-sm font-semibold text-stone-900">{siteConfig.name}</p>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-stone-500">
          {siteConfig.description}
        </p>
        <p class="mt-4 text-xs text-stone-400">
          A directory only — not an exam provider, school or certification
          authority.
        </p>
      </div>

      <nav aria-label="Exams">
        <p class="text-sm font-semibold text-stone-900">Popular Exam Hubs</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/exam/ielts/" class="text-stone-600 hover:text-blue-700">IELTS Study Groups</a></li>
          <li><a href="/exam/sat/" class="text-stone-600 hover:text-blue-700">SAT Study Groups</a></li>
          <li><a href="/exam/usmle/" class="text-stone-600 hover:text-blue-700">USMLE Prep Groups</a></li>
          <li><a href="/exam/nclex/" class="text-stone-600 hover:text-blue-700">NCLEX Nursing Groups</a></li>
          <li><a href="/exam/neet/" class="text-stone-600 hover:text-blue-700">NEET Study Channels</a></li>
          <li><a href="/exam/jee/" class="text-stone-600 hover:text-blue-700">JEE Exam Groups</a></li>
          <li><a href="/exam/upsc/" class="text-stone-600 hover:text-blue-700">UPSC IAS Groups</a></li>
          <li><a href="/exam/cfa/" class="text-stone-600 hover:text-blue-700">CFA Study Hubs</a></li>
          <li><a href="/exam/pmp/" class="text-stone-600 hover:text-blue-700">PMP Certification Groups</a></li>
        </ul>
      </nav>

      <nav aria-label="Platforms and Categories">
        <p class="text-sm font-semibold text-stone-900">Platforms &amp; Categories</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/platform/telegram/" class="text-stone-600 hover:text-blue-700">Telegram Study Groups</a></li>
          <li><a href="/platform/discord/" class="text-stone-600 hover:text-blue-700">Discord Study Servers</a></li>
          <li><a href="/platform/whatsapp/" class="text-stone-600 hover:text-blue-700">WhatsApp Study Chats</a></li>
          <li class="pt-2 text-xs font-semibold uppercase tracking-wide text-stone-400">Categories</li>
          <li><a href="/category/college-admissions/" class="text-stone-600 hover:text-blue-700">College Admissions</a></li>
          <li><a href="/category/medical-healthcare/" class="text-stone-600 hover:text-blue-700">Medical &amp; Healthcare</a></li>
          <li><a href="/category/entrance-exams/" class="text-stone-600 hover:text-blue-700">Entrance Exams</a></li>
          <li><a href="/category/english-proficiency/" class="text-stone-600 hover:text-blue-700">English Proficiency</a></li>
        </ul>
      </nav>

      <nav aria-label="Trust and Governance">
        <p class="text-sm font-semibold text-stone-900">Trust &amp; Governance</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/academic-integrity/" class="font-medium text-blue-700 hover:underline">Academic Integrity Policy</a></li>
          <li><a href="/how-we-verify/" class="text-stone-600 hover:text-blue-700">How We Verify</a></li>
          <li><a href="/safety/" class="text-stone-600 hover:text-blue-700">Study Safety</a></li>
          <li><a href="/editorial-policy/" class="text-stone-600 hover:text-blue-700">Editorial Policy</a></li>
          <li><a href="/about/" class="text-stone-600 hover:text-blue-700">About StudyGroupsHub</a></li>
          <li><a href="/report/" class="text-stone-600 hover:text-blue-700">Report a Listing</a></li>
          <li><a href="/privacy/" class="text-stone-600 hover:text-blue-700">Privacy Policy</a></li>
          <li><a href="/terms/" class="text-stone-600 hover:text-blue-700">Terms of Service</a></li>
          <li><a href="/disclaimer/" class="text-stone-600 hover:text-blue-700">Disclaimer</a></li>
        </ul>
      </nav>
    </div>

    <div class="mt-10 border-t border-stone-200 pt-6 text-center">
      <p class="text-xs text-stone-400">
        © {new Date().getFullYear()} {siteConfig.name}. Not affiliated with Discord, Telegram,
        WhatsApp, or any exam provider or certification body.
      </p>
    </div>
  </div>
</footer>