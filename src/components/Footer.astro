---
import { siteConfig } from '../config/site';
import { examFamilies } from '../config/examFamilies';
import { platforms } from '../config/platforms';
---

<footer class="mt-16 border-t border-stone-200 bg-surface">
  <div class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="text-sm font-semibold text-stone-900">{siteConfig.name}</p>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-stone-500">
          {siteConfig.description}
        </p>
        <p class="mt-4 text-xs text-stone-400">
          A directory only — not an exam provider, school or certification
          authority.
        </p>
      </div>

      <nav aria-label="Exams">
        <p class="text-sm font-semibold text-stone-900">Browse Exams</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            examFamilies.slice(0, 8).map((fam) => (
              <li>
                <a href={`/category/${fam.slug}/`} class="text-stone-600 hover:text-blue-700">
                  {fam.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Platforms">
        <p class="text-sm font-semibold text-stone-900">Platforms</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            platforms.map((p) => (
              <li>
                <a href={`/platform/${p.id}/`} class="text-stone-600 hover:text-blue-700">
                  {p.name} study groups
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="About">
        <p class="text-sm font-semibold text-stone-900">Directory</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/communities/" class="text-stone-600 hover:text-blue-700">Browse Communities</a></li>
          <li><a href="/submit/" class="text-stone-600 hover:text-blue-700">Submit Community</a></li>
          <li><a href="/report/" class="text-stone-600 hover:text-blue-700">Report a Listing</a></li>
          <li><a href="/safety/" class="text-stone-600 hover:text-blue-700">Study Safety</a></li>
          <li><a href="/how-we-verify/" class="text-stone-600 hover:text-blue-700">How We Verify</a></li>
          <li><a href="/editorial-policy/" class="text-stone-600 hover:text-blue-700">Editorial Policy</a></li>
          <li><a href="/about/" class="text-stone-600 hover:text-blue-700">About</a></li>
          <li><a href="/contact/" class="text-stone-600 hover:text-blue-700">Contact</a></li>
          <li><a href="/privacy/" class="text-stone-600 hover:text-blue-700">Privacy</a></li>
          <li><a href="/terms/" class="text-stone-600 hover:text-blue-700">Terms</a></li>
          <li><a href="/disclaimer/" class="text-stone-600 hover:text-blue-700">Disclaimer</a></li>
        </ul>
      </nav>
    </div>

    <div class="mt-10 border-t border-stone-200 pt-6 text-center">
      <p class="text-xs text-stone-400">
        © {new Date().getFullYear()} {siteConfig.name}. Not affiliated with Discord, Telegram,
        WhatsApp, or any exam provider or certification body.
      </p>
    </div>
  </div>
</footer>