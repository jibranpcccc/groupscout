---
import type { VerificationStatus } from '../types/community';

interface Props {
  status: VerificationStatus;
  size?: 'sm' | 'md';
}

const { status, size = 'sm' } = Astro.props;
const textClass = size === 'sm' ? 'text-xs' : 'text-sm';

/**
 * Verification badges are strictly mapped to the real verification state.
 * The word "Verified" never appears unless the state justifies it.
 */
const styles: Record<VerificationStatus, { label: string; className: string }> = {
  unverified: {
    label: 'Unverified',
    className: 'text-stone-600 bg-stone-50 border-stone-200',
  },
  'source-confirmed': {
    label: 'Source confirmed',
    className: 'text-blue-700 bg-blue-50 border-blue-200',
  },
  'owner-confirmed': {
    label: 'Owner confirmed',
    className: 'text-violet-700 bg-violet-50 border-violet-200',
  },
  'manually-reviewed': {
    label: 'Manually reviewed',
    className: 'text-emerald-700 bg-emerald-50 border-emerald-200',
  },
};

const s = styles[status];
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 font-medium',
    textClass,
    s.className,
  ]}
  title="Verification status — see /how-we-verify/"
>
  <svg viewBox="0 0 20 20" fill="currentColor" class="size-3" aria-hidden="true">
    <path
      fill-rule="evenodd"
      d="M10 1.5 11.9 3l2.5-.3.7 2.4 2.2 1.2-.8 2.4.8 2.4-2.2 1.2-.7 2.4-2.5-.3L10 16.5 8.1 15l-2.5.3-.7-2.4-2.2-1.2.8-2.4-.8-2.4 2.2-1.2.7-2.4 2.5.3L10 1.5zM9 12.6l4.7-4.7-1.1-1.1L9 10.4 7.4 8.8 6.3 9.9 9 12.6z"
      clip-rule="evenodd"
    />
  </svg>
  {s.label}
</span>
