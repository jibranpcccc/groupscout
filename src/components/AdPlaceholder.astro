---
/**
 * Optional ad placeholder. Renders nothing when SHOW_AD_PLACEHOLDERS is
 * not "true" — the site looks complete without advertising.
 */
interface Props {
  slot: 'leaderboard' | 'in-content' | 'sidebar' | 'mobile';
}

const { slot } = Astro.props;
const show = import.meta.env.SHOW_AD_PLACEHOLDERS === 'true';

const heights: Record<string, string> = {
  leaderboard: 'h-24',
  'in-content': 'h-32',
  sidebar: 'h-64',
  mobile: 'h-24',
};
---

{
  show && (
    <div
      class={[
        'flex w-full items-center justify-center rounded-xl border border-dashed border-stone-300 bg-stone-50 text-xs text-stone-400',
        heights[slot],
      ].join(' ')}
      aria-hidden="true"
    >
      Ad placeholder ({slot}) — disabled by default
    </div>
  )
}
