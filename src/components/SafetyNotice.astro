---
interface Props {
  /** 'general' | 'financial' | 'external' | 'study' — controls wording. */
  variant?: 'general' | 'financial' | 'external' | 'study';
  class?: string;
}

const { variant = 'general' } = Astro.props;
const className = Astro.props.class;

const copy: Record<string, { title: string; body: string }> = {
  general: {
    title: 'About this listing',
    body: 'Directory inclusion is not an endorsement of content shared inside a community. Verify any claims independently and never share sensitive personal information based on a directory listing.',
  },
  financial: {
    title: 'Financial disclaimer',
    body: 'Communities listed here may discuss financial markets. Directory inclusion does not constitute financial advice, an endorsement, or verification of performance claims. Verify claims independently and never send money or sensitive information based solely on a directory listing.',
  },
  external: {
    title: 'External links',
    body: 'Links leave this site. We do not control or endorse external content. Check the destination before joining.',
  },
  study: {
    title: 'Study safety notice',
    body: 'Directory inclusion is not an endorsement of study materials or claims made inside a community. Avoid groups offering leaked exams, guaranteed test questions, impersonation services or unauthorized credentials. See Study Safety for guidance.',
  },
};

const { title, body } = copy[variant];
---

<aside class={['rounded-xl border border-amber-200 bg-amber-50/70 p-5', className].filter(Boolean).join(' ')}>
  <h2 class="text-sm font-semibold text-stone-900">{title}</h2>
  <p class="mt-1 text-sm leading-relaxed text-stone-600">{body}</p>
</aside>