---
import { siteConfig } from '../config/site';
import { buildMeta } from '../lib/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  noCanonical?: boolean;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  /** Raw JSON-LD string (use jsonLd() from src/lib/seo.ts). */
  jsonLd?: string;
}

const {
  title,
  description,
  canonicalPath = '/',
  noCanonical = false,
  noindex = false,
  ogType = 'website',
  ogImage,
  jsonLd,
} = Astro.props;

const meta = buildMeta({ title, description, canonicalPath, noindex, ogType, ogImage });
const showCanonical = !noCanonical && canonicalPath !== '/404/' && !canonicalPath.includes('404');
---

<!doctype html>
<html lang={siteConfig.defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {showCanonical && <link rel="canonical" href={meta.canonical} />}
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    <meta property="og:type" content={meta.og.type} />
    <meta property="og:url" content={meta.og.url} />
    <meta property="og:title" content={meta.og.title} />
    <meta property="og:description" content={meta.og.description} />
    <meta property="og:image" content={meta.og.image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:site_name" content={meta.og.siteName} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content={meta.twitter.card} />
    <meta name="twitter:title" content={meta.twitter.title} />
    <meta name="twitter:description" content={meta.twitter.description} />
    <meta name="twitter:image" content={meta.twitter.image} />

    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.name} href="/rss.xml" />

    {
      siteConfig.googleSiteVerification && (
        <meta name="google-site-verification" content={siteConfig.googleSiteVerification} />
      )
    }
    {
      siteConfig.bingSiteVerification && (
        <meta name="msvalidate.01" content={siteConfig.bingSiteVerification} />
      )
    }

    {
      siteConfig.gaMeasurementId && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.gaMeasurementId}`}
          />
          <script
            is:inline
            set:html={`
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', '${siteConfig.gaMeasurementId}', { anonymize_ip: true });
            `}
          />
        </>
      )
    }

    <script is:inline>
      // Theme bootstrap: respect stored preference, else system preference.
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const dark =
            stored === 'dark' ||
            (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', dark);
        } catch {
          /* localStorage unavailable — keep light default */
        }
      })();
    </script>

    {
      jsonLd && <script type="application/ld+json" set:html={jsonLd} is:inline />
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-blue-600 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to main content
    </a>
    <Header />
    <main id="main-content" class="flex-1 pb-16 md:pb-0">
      <slot />
    </main>
    <Footer />

    <!-- Mobile Bottom Action Dock (2026 Mobile CRO Standard) -->
    <nav
      aria-label="Mobile quick actions"
      class="fixed bottom-0 inset-x-0 z-40 flex items-center justify-around border-t border-stone-200 bg-surface/95 px-2 py-2 backdrop-blur-md md:hidden"
    >
      <a
        href="/communities/"
        class="flex flex-col items-center gap-0.5 rounded-lg px-3 py-1 text-xs font-semibold text-stone-700 hover:text-blue-700 active:scale-95 transition-all"
      >
        <svg class="size-5 text-stone-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span>Browse</span>
      </a>
      <a
        href="/#exams"
        class="flex flex-col items-center gap-0.5 rounded-lg px-3 py-1 text-xs font-semibold text-stone-700 hover:text-blue-700 active:scale-95 transition-all"
      >
        <svg class="size-5 text-stone-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <span>Exams</span>
      </a>
      <a
        href="/submit/"
        class="flex flex-col items-center gap-0.5 rounded-lg px-3 py-1 text-xs font-semibold text-blue-700 hover:text-blue-900 active:scale-95 transition-all"
      >
        <svg class="size-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Submit</span>
      </a>
    </nav>
  </body>
</html>
