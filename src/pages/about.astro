---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageTitle, canonicalUrl, graphJsonLd, breadcrumbGraphNode } from '../lib/seo';
import { siteConfig } from '../config/site';
import { getDatasetStats, getPublishedCommunities } from '../lib/communities';
import { examFamilies, getExamFamilyName } from '../config/examFamilies';
import { platforms } from '../config/platforms';
import { getExamName } from '../config/exams';

const stats = getDatasetStats();
const published = getPublishedCommunities();

// Covered-exam metrics are computed from the live dataset, never guessed.
const coveredExams = [...new Set(published.flatMap((c) => c.exams))].sort((a, b) =>
  getExamName(a).localeCompare(getExamName(b))
);
const coveredFamilies = [
  ...new Set(
    published.flatMap((c) =>
      c.examFamilies.length > 0
        ? c.examFamilies
        : (c.category ? [c.category] : [])
    )
  ),
].sort((a, b) => getExamFamilyName(a).localeCompare(getExamFamilyName(b)));

const canonicalPath = '/about/';
const pageUrl = canonicalUrl(canonicalPath);
const aboutDesc = `Learn how ${siteConfig.name} catalogs public Telegram and Discord study communities with automated link checks, transparent verification, and anti-dump screening.`;

const aboutGraph = graphJsonLd([
  breadcrumbGraphNode([{ name: 'About', path: canonicalPath }], pageUrl),
  {
    '@type': 'AboutPage',
    name: `About ${siteConfig.name}`,
    url: pageUrl,
    description: aboutDesc,
  },
]);
---

<BaseLayout
  title={pageTitle('About Our Exam Study Directory')}
  description={aboutDesc}
  canonicalPath={canonicalPath}
  jsonLd={aboutGraph}
>
  <div class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
    <h1 class="text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl">About</h1>
    <div class="prose-static mt-6">
      <p>
        {siteConfig.name} is a searchable directory of{' '}
        <strong>public exam-prep and professional-certification study communities</strong>{' '}
        across {platforms.map((p) => p.name).join(', ')}. It helps students find active peer
        groups for exams like the{' '}
        <a href="/exam/sat/">SAT</a>, <a href="/exam/gre/">GRE</a>,{' '}
        <a href="/exam/ielts/">IELTS</a>, <a href="/exam/usmle/">USMLE</a>,{' '}
        <a href="/exam/cfa/">CFA</a>, <a href="/exam/pmp/">PMP</a>, and{' '}
        <a href="/exam/cissp/">CISSP</a>, and shows transparent verification states before you join.
      </p>

      <h2>Why it exists</h2>
      <p>
        Study groups are scattered across <a href="/platform/discord/">Discord</a>,{' '}
        <a href="/platform/telegram/">Telegram</a>, and WhatsApp, and most students discover
        them through word of mouth or search. Many are helpful; some sell fake exam dumps,
        impersonate tutors, or push credential scams. {siteConfig.name} makes public options
        easier to inspect: which communities exist, which exams they cover, and which invite
        links respond, paired with practical <a href="/safety/">safety guidance</a>.
      </p>

      <h2>Where listings come from</h2>
      <p>
        Listings are identified from publicly available sources: web search discovery,
        direct submissions, and manual curation. Every listing stores its source URLs,
        discovery date, verification state, and link-check status. Listings are organized
        by exam, exam family, target market, and study type.
      </p>

      <h2>What this directory is not</h2>
      <p>
        We are not an exam provider, a school, a tutoring service, or a certification
        authority. Inclusion is not an endorsement. We do not join groups, scrape member
        data, or claim that any community is "safe" or that its materials are official.
        See <a href="/safety/">Safety</a> and{' '}
        <a href="/how-we-verify/">How We Verify</a>.
      </p>

      <h2>Current dataset</h2>
      <ul>
        <li>{stats.listed} published study communities</li>
        <li>{stats.categories} exam families with listings</li>
        <li>{coveredFamilies.length} exam families represented in the dataset</li>
        <li>{coveredExams.length} exams and certifications covered</li>
        <li>{stats.platforms} platforms</li>
        <li>{stats.withMemberCounts} listings with a sourced member count</li>
      </ul>
      <p>
        Numbers above are computed directly from the live JSON dataset. We never display
        invented statistics.
      </p>

      <h2>Exam families</h2>
      <ul>
        {examFamilies.map((f) => (
          <li>
            <a href={`/category/${f.slug}/`}>{f.name}</a>: {f.description}
          </li>
        ))}
      </ul>

      <h2 id="editorial-team">Editorial team and verification standards</h2>
      <p>
        To protect students from predatory scammers, fraudulent score-guarantee schemes, and
        unauthorized material distribution, StudyGroupsHub operates under strict editorial
        oversight and automated monitoring:
      </p>
      <ul>
        <li>
          <strong>Who reviews listings:</strong> Our research and editorial team reviews candidate
          communities to confirm that active discussions focus on legitimate test preparation,
          peer problem-solving, and study partner accountability.
        </li>
        <li>
          <strong>How verification works:</strong> Automated monitoring tests invite link
          accessibility on a regular schedule, while human editors screen listings against
          braindumps, stolen question banks, and proxy test-taking services per our{' '}
          <a href="/academic-integrity/">Academic Integrity Policy</a>.
        </li>
        <li>
          <strong>Why we publish:</strong> To provide candidates with a structured, spam-filtered
          directory for connecting with dedicated peers across major standardized tests and
          professional certifications.
        </li>
      </ul>

      <h2>Contact</h2>
      <p>
        Questions, corrections, or removal requests? Use the{' '}
        <a href="/contact/">contact page</a>, <a href="/submit/">submit a
        community</a>, or <a href="/report/">report a listing</a>.
      </p>
    </div>
  </div>
</BaseLayout>
