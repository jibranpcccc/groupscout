---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageTitle } from '../../lib/seo';

/** Non-indexable success page for the report form. */
---

<BaseLayout
  title={pageTitle('Report Received')}
  description="Your report was received."
  canonicalPath="/report/success/"
  noindex
>
  <div class="mx-auto w-full max-w-2xl px-4 py-20 text-center sm:px-6">
    <div class="mx-auto grid size-14 place-items-center rounded-full bg-emerald-100 text-emerald-700" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-7">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h1 class="mt-6 text-2xl font-bold text-stone-900">Report received</h1>
    <p class="mt-3 text-stone-600">
      Thank you for helping keep the study-community directory accurate. Reports — including
      concerns about exam leaks, dumps or credential fraud — are reviewed manually and never
      trigger automatic removal.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="btn-primary">Back to home</a>
      <a href="/communities/" class="btn-secondary">Browse communities</a>
    </div>
  </div>
</BaseLayout>