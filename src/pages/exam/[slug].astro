---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchBox from '../../components/SearchBox.astro';
import PlatformBadge from '../../components/PlatformBadge.astro';
import CommunityGrid from '../../components/CommunityGrid.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { exams, getExam, getExamName } from '../../config/exams';
import { getExamFamily, getExamFamilyName } from '../../config/examFamilies';
import { getPublishedCommunities } from '../../lib/communities';
import { EXAM_INDEX_MIN } from '../../config/discovery';
import { pageTitle, collectionPageJsonLd, breadcrumbJsonLd } from '../../lib/seo';

export const getStaticPaths = (() => {
  return exams.map((exam) => ({ params: { slug: exam.slug }, props: { exam } }));
}) satisfies GetStaticPaths;

const { exam } = Astro.props;

const published = getPublishedCommunities().filter((c) => (c.exams ?? []).includes(exam.slug));
const family = getExamFamily(exam.family);
const relatedExams = (family?.exams ?? []).filter((slug) => slug !== exam.slug);
const platformBreakdown = new Map<string, number>();
for (const c of published) {
  platformBreakdown.set(c.platform, (platformBreakdown.get(c.platform) ?? 0) + 1);
}
const platformNames: Record<string, string> = { discord: 'Discord', telegram: 'Telegram', whatsapp: 'WhatsApp' };
const platformsWithInventory = [...platformBreakdown.entries()]
  .map(([id, count]) => `${platformNames[id] ?? id} (${count})`)
  .join(', ');

const noindex = published.length < EXAM_INDEX_MIN;
const title = published.length === 0
  ? `${exam.name} Study Groups`
  : `${exam.name} Study Groups — ${platformsWithInventory} | StudyScout`;

const crumbs = [
  { label: 'Exams', href: '/communities/' },
  { label: exam.name },
];
---

<BaseLayout
  title={title}
  description={`${exam.description} Browse and discover ${exam.name} study communities across Discord, Telegram and WhatsApp.`}
  canonicalPath={`/exam/${exam.slug}/`}
  noindex={noindex}
  jsonLd={`${breadcrumbJsonLd(crumbs.map((c) => ({ name: c.label, path: c.href ?? `#${c.label}` })))}\n${collectionPageJsonLd(exam.name, exam.description, published)}`}
>
  <Breadcrumbs items={crumbs} />

  <section class="border-b border-stone-200 bg-gradient-to-b from-blue-50/70 to-canvas">
    <div class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6">
      <h1 class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl">
        {exam.name} Study Groups
      </h1>
      <p class="mt-3 max-w-2xl text-stone-600">{exam.description}</p>
      <div class="mt-6 flex flex-wrap items-center gap-3 text-sm">
        <span class="rounded-full bg-blue-100 px-3 py-1 font-medium text-blue-800">
          {getExamName(exam.slug)}
        </span>
        <a
          href={`/category/${exam.family}/`}
          class="rounded-full bg-stone-100 px-3 py-1 font-medium text-stone-700 hover:bg-stone-200"
        >
          {family ? family.name : getExamFamilyName(exam.family)}
        </a>
        <span class="text-stone-500">{published.length} listed</span>
      </div>
      <div class="mt-6 max-w-xl">
        <SearchBox size="sm" placeholder={`Search ${exam.name} study groups…`} />
      </div>
    </div>
  </section>

  {
    published.length > 0 ? (
      <section class="mx-auto w-full max-w-6xl px-4 pt-8 sm:px-6">
        <CommunityGrid communities={published} />
      </section>
    ) : (
      <section class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6">
        <div class="rounded-xl border border-stone-200 bg-surface p-8 text-center">
          <p class="font-semibold text-stone-900">No {exam.name} study groups listed yet.</p>
          <p class="mt-2 text-sm text-stone-600">
            New communities are being reviewed. Know one?{" "}
            <a href="/submit/" class="font-medium text-blue-700 hover:underline">Submit it</a>.
          </p>
        </div>
      </section>
    )
  }

  {
    relatedExams.length > 0 && (
      <section class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6">
        <h2 class="text-lg font-semibold text-stone-900">Related Exams</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {
            relatedExams.map((slug) => (
              <a
                href={`/exam/${slug}/`}
                class="rounded-lg border border-stone-200 bg-surface px-3 py-1.5 text-sm font-medium text-stone-700 hover:border-blue-300 hover:text-blue-700"
              >
                {getExamName(slug)}
              </a>
            ))
          }
        </div>
      </section>
    )
  }
</BaseLayout>