---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
import PlatformBadge from '../components/PlatformBadge.astro';
import CommunityGrid from '../components/CommunityGrid.astro';
import SafetyNotice from '../components/SafetyNotice.astro';
import AdPlaceholder from '../components/AdPlaceholder.astro';
import { siteConfig } from '../config/site';
import { categories } from '../config/categories';
import { platforms } from '../config/platforms';
import {
  getPublishedCommunities,
  getRecentlyAdded,
  getRecentlyChecked,
  getDatasetStats,
} from '../lib/communities';
import { pageTitle, websiteJsonLd, organizationJsonLd } from '../lib/seo';

const stats = getDatasetStats();
const recentlyAdded = getRecentlyAdded(8);
const recentlyChecked = getRecentlyChecked(8);
const categoryCounts = new Map(
  categories.map((c) => [c.slug, getPublishedCommunities().filter((x) => x.category === c.slug).length])
);
---

<BaseLayout
  title={pageTitle()}
  description={siteConfig.description}
  canonicalPath="/"
  jsonLd={`${websiteJsonLd()}\n${organizationJsonLd()}`}
>
  <!-- Hero -->
  <section class="border-b border-stone-200 bg-gradient-to-b from-blue-50/80 to-canvas">
    <div class="mx-auto w-full max-w-6xl px-4 py-16 text-center sm:px-6 sm:py-20">
      <h1 class="mx-auto max-w-3xl text-3xl font-bold tracking-tight text-stone-900 sm:text-5xl">
        Find Communities Worth Joining
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-stone-600 sm:text-lg">
        {siteConfig.name} helps you discover public online communities across
        Telegram, WhatsApp and Discord — categorized, checked and ready to explore.
      </p>

      <div class="mt-8 flex justify-center">
        <SearchBox size="lg" id="hero-search" />
      </div>

      <dl class="mx-auto mt-10 flex max-w-xl flex-wrap items-center justify-center gap-x-10 gap-y-4">
        <div>
          <dt class="sr-only">Listed communities</dt>
          <dd class="text-2xl font-bold text-stone-900">{stats.listed}</dd>
          <dd class="text-xs font-medium uppercase tracking-wide text-stone-500">Listed Communities</dd>
        </div>
        <div>
          <dt class="sr-only">Categories</dt>
          <dd class="text-2xl font-bold text-stone-900">{stats.categories}</dd>
          <dd class="text-xs font-medium uppercase tracking-wide text-stone-500">Categories</dd>
        </div>
        <div>
          <dt class="sr-only">Platforms</dt>
          <dd class="text-2xl font-bold text-stone-900">{stats.platforms}</dd>
          <dd class="text-xs font-medium uppercase tracking-wide text-stone-500">Platforms</dd>
        </div>
        <div>
          <dt class="sr-only">Recently checked</dt>
          <dd class="text-2xl font-bold text-stone-900">{stats.recentlyChecked}</dd>
          <dd class="text-xs font-medium uppercase tracking-wide text-stone-500">Recently Checked</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Platforms -->
  <section class="mx-auto w-full max-w-6xl px-4 pt-12 sm:px-6">
    <div class="flex items-end justify-between">
      <h2 class="text-xl font-semibold text-stone-900">Browse by Platform</h2>
      <a href="/communities/" class="text-sm font-medium text-blue-700 hover:text-blue-800">
        Browse all →
      </a>
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      {
        platforms.map((p) => (
          <a
            href={`/platform/${p.id}/`}
            class="card group p-5 transition-shadow hover:shadow-md"
          >
            <div class="flex items-center gap-3">
              <PlatformBadge platform={p.id} size="md" showName={false} />
              <div>
                <p class="font-semibold text-stone-900 group-hover:text-blue-700">{p.name}</p>
                <p class="text-xs text-stone-500">{p.description}</p>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Categories -->
  <section class="mx-auto w-full max-w-6xl px-4 pt-12 sm:px-6">
    <h2 class="text-xl font-semibold text-stone-900">Browse by Category</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((cat) => (
          <a
            href={`/category/${cat.slug}/`}
            class="card group flex flex-col justify-between p-5 transition-shadow hover:shadow-md"
          >
            <div>
              <p class="font-semibold text-stone-900 group-hover:text-blue-700">{cat.name}</p>
              <p class="mt-1 line-clamp-2 text-sm text-stone-500">{cat.description}</p>
            </div>
            <p class="mt-3 text-xs font-medium text-stone-400">
              {categoryCounts.get(cat.slug) ?? 0} listed
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Recently added -->
  <section class="mx-auto w-full max-w-6xl px-4 pt-12 sm:px-6">
    <div class="flex items-end justify-between">
      <h2 class="text-xl font-semibold text-stone-900">Recently Added</h2>
      <a href="/recently-added/" class="text-sm font-medium text-blue-700 hover:text-blue-800">
        View all →
      </a>
    </div>
    <div class="mt-4">
      <CommunityGrid communities={recentlyAdded} />
    </div>
  </section>

  <AdPlaceholder slot="leaderboard" />

  <!-- Recently checked -->
  <section class="mx-auto w-full max-w-6xl px-4 pt-12 sm:px-6">
    <div class="flex items-end justify-between">
      <h2 class="text-xl font-semibold text-stone-900">Recently Checked</h2>
      <a href="/recently-updated/" class="text-sm font-medium text-blue-700 hover:text-blue-800">
        View all →
      </a>
    </div>
    <div class="mt-4">
      <CommunityGrid communities={recentlyChecked} />
    </div>
  </section>

  <!-- Trust + CTA -->
  <section class="mx-auto w-full max-w-6xl px-4 pt-12 sm:px-6">
    <SafetyNotice />
    <div class="card mt-6 flex flex-col items-center gap-4 p-8 text-center sm:flex-row sm:justify-between sm:text-left">
      <div>
        <p class="text-lg font-semibold text-stone-900">Know a public community worth listing?</p>
        <p class="mt-1 text-sm text-stone-500">
          Submissions are reviewed before publication — no automatic listings.
        </p>
      </div>
      <a href="/submit/" class="btn-primary shrink-0">Submit a Community</a>
    </div>
  </section>
</BaseLayout>
