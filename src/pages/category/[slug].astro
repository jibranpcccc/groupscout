---
import DirectoryLayout from '../../layouts/DirectoryLayout.astro';
import CommunityGrid from '../../components/CommunityGrid.astro';
import FilterBar from '../../components/FilterBar.astro';
import EmptyState from '../../components/EmptyState.astro';
import SafetyNotice from '../../components/SafetyNotice.astro';
import { categories, getCategoryBySlug, slugifyTag } from '../../config/categories';
import { getExamFamily } from '../../config/examFamilies';
import { getExam } from '../../config/exams';
import { getByCategory, getPublishedCommunities } from '../../lib/communities';
import { sortCommunities, availableFilterOptions } from '../../lib/filters';
import { PAGE_SIZE, EXAM_INDEX_MIN } from '../../config/discovery';
import { pageTitle, breadcrumbJsonLd, jsonLd } from '../../lib/seo';
import { jsonForClient } from '../../scripts/directory';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const category = getCategoryBySlug(slug ?? '');
if (!category) return Astro.redirect('/404', 301);

const all = getByCategory(category.slug);
const sorted = sortCommunities(all, 'newest');
const pageOne = sorted.slice(0, PAGE_SIZE);
const options = availableFilterOptions(all);
const examFamily = getExamFamily(category.slug);
const childExams = (examFamily?.exams ?? [])
  .map((s) => getExam(s))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));

const publishedAll = getPublishedCommunities();
const examCounts = new Map<string, number>();
for (const c of publishedAll) {
  for (const e of c.exams ?? []) {
    examCounts.set(e, (examCounts.get(e) ?? 0) + 1);
  }
}

const hasIndexableChildExam = childExams.some((e) => (examCounts.get(e.slug) ?? 0) >= EXAM_INDEX_MIN);
const isCategoryIndexable = all.length >= 5 || (all.length > 0 && hasIndexableChildExam);

const categoryMetaMap: Record<string, { title: string; metaDesc: string }> = {
  'english-proficiency': {
    title: 'English Language Exam Study Groups',
    metaDesc: 'Find active study groups for IELTS, TOEFL, PTE, and Cambridge English exams across Telegram and Discord on StudyGroupsHub.',
  },
  'medical-healthcare': {
    title: 'Medical & Healthcare Exam Study Groups',
    metaDesc: 'Browse verified study groups for USMLE, NCLEX, MCAT, and medical certification exams across Discord and Telegram.',
  },
  'college-admissions': {
    title: 'College Admissions Exam Study Groups',
    metaDesc: 'Explore active student communities and study groups for SAT, ACT, and AP exams on Discord and Telegram.',
  },
  'graduate-admissions': {
    title: 'Graduate Admissions Exam Study Groups',
    metaDesc: 'Connect with peers in GRE, GMAT, and graduate school entrance exam study groups on Telegram and Discord.',
  },
  'finance-accounting': {
    title: 'Finance & Accounting Exam Study Groups',
    metaDesc: 'Find peer study communities and prep channels for CFA, CPA, and financial professional certification exams.',
  },
  'cybersecurity-certifications': {
    title: 'IT & Cybersecurity Certification Study Groups',
    metaDesc: 'Browse active study groups for AWS, CompTIA Security+, CISSP, and CCNA cloud and cybersecurity certifications.',
  },
  'entrance-exams': {
    title: 'National Entrance Exam Study Groups',
    metaDesc: 'Explore student channels and revision study groups for UPSC, JEE, NEET, GATE, and national competitive entrance exams.',
  },
  'law': {
    title: 'Law School & Legal Exam Study Groups',
    metaDesc: 'Find law student communities and preparation groups for the LSAT and bar entrance examinations on StudyGroupsHub.',
  },
};

const customMeta = categoryMetaMap[category.slug];
const pageTitleStr = pageTitle(customMeta?.title ?? `${category.name} Study Groups & Communities`);
const pageDescStr = customMeta?.metaDesc ?? `${category.description} Browse and filter public ${category.name} study groups on StudyGroupsHub.`;

const pageLd = jsonLd({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${category.name} Study Groups`,
  description: category.description,
  url: `/category/${category.slug}/`,
});
---

<DirectoryLayout
  title={pageTitleStr}
  description={pageDescStr}
  canonicalPath={`/category/${category.slug}/`}
  noindex={!isCategoryIndexable}
  intro={category.description}
  count={`${all.length} ${all.length === 1 ? 'community' : 'communities'}`}
  breadcrumbs={[{ label: category.name }]}
  jsonLd={`${breadcrumbJsonLd([{ name: category.name, path: `/category/${category.slug}/` }])}\n${pageLd}`}
>
  {
    category.note && (
      <p class="mb-4 rounded-lg border border-stone-200 bg-stone-50 p-3 text-sm text-stone-600">
        {category.note}
      </p>
    )
  }
  {
    category.financialDisclaimerRequired && <SafetyNotice variant="financial" class="mb-4" />
  }

  <FilterBar options={options} current={{ category: category.slug }} basePath={`/category/${category.slug}/`} />

  <p data-directory-summary class="mt-4 text-sm text-stone-500">
    {all.length > 0
      ? `Showing 1–${Math.min(PAGE_SIZE, all.length)} of ${all.length}`
      : 'No communities in this category yet'}
  </p>

  <div class="mt-4">
    {
      all.length === 0 ? (
        <EmptyState message="No communities in this category yet." />
      ) : (
        <div
          id="directory-view"
          data-base={`/category/${category.slug}/`}
          data-page-size={PAGE_SIZE}
        >
          <script type="application/json" id="directory-data" set:html={jsonForClient(all)} is:inline />
          <CommunityGrid communities={pageOne} />
        </div>
      )
    }
  </div>

  {
    childExams.length > 0 && (
      <div class="mt-8 border-t border-stone-200 pt-6">
        <h2 class="text-base font-semibold text-stone-900">Exam Hubs in {category.name}</h2>
        <p class="mt-1 text-sm text-stone-500">Explore dedicated study communities and preparation channels by exam.</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {
            childExams.map((ex) => (
              <a
                href={`/exam/${ex.slug}/`}
                class="inline-flex items-center gap-1.5 rounded-lg border border-blue-200 bg-blue-50/60 px-3 py-1.5 text-sm font-medium text-blue-800 hover:bg-blue-100"
              >
                <span>{ex.name} Study Groups</span>
              </a>
            ))
          }
        </div>
      </div>
    )
  }

  <div class="mt-8">
    <h2 class="text-sm font-semibold text-stone-900">Tags in this category</h2>
    <div class="mt-3 flex flex-wrap gap-2">
      {
        category.tags.map((tag) => (
          <a
            href={`/tag/${slugifyTag(tag)}/`}
            class="rounded-full border border-stone-200 bg-surface px-3 py-1 text-sm text-stone-600 hover:border-blue-300 hover:text-blue-700"
          >
            {tag}
          </a>
        ))
      }
    </div>
  </div>
</DirectoryLayout>

<script>
  import { initDirectoryView } from '../../scripts/directory';
  initDirectoryView();
</script>
