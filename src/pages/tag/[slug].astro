---
import DirectoryLayout from '../../layouts/DirectoryLayout.astro';
import CommunityGrid from '../../components/CommunityGrid.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getAllTags, slugifyTag, getCategoryBySlug } from '../../config/categories';
import { getByTag, getPublishedCommunities } from '../../lib/communities';
import { TAG_PAGE_MIN_COMMUNITIES } from '../../config/discovery';
import {
  tagPageTitle,
  canonicalUrl,
  graphJsonLd,
  breadcrumbGraphNode,
  collectionPageGraphNode,
} from '../../lib/seo';

/**
 * Tag pages are generated ONLY for tags with enough actual listings
 * (TAG_PAGE_MIN_COMMUNITIES). Zero/empty tag pages are never produced.
 */
export function getStaticPaths() {
  const published = getPublishedCommunities();
  const counts = new Map<string, number>();
  for (const c of published) {
    for (const t of c.tags) {
      const s = slugifyTag(t);
      counts.set(s, (counts.get(s) ?? 0) + 1);
    }
  }
  return getAllTags()
    .filter((t) => (counts.get(t.slug) ?? 0) >= TAG_PAGE_MIN_COMMUNITIES)
    .map((t) => ({ params: { slug: t.slug } }));
}

const { slug } = Astro.params;
const allTags = getAllTags();
const tag = allTags.find((t) => t.slug === slug);
if (!tag) return Astro.redirect('/404', 301);

const communities = getByTag(tag.slug);
const category = getCategoryBySlug(tag.categorySlug);
if (communities.length < TAG_PAGE_MIN_COMMUNITIES) {
  return Astro.redirect(`/category/${tag.categorySlug}/`, 301);
}

const canonicalPath = `/tag/${tag.slug}/`;
const pageUrl = canonicalUrl(canonicalPath);

const tagGraph = graphJsonLd([
  breadcrumbGraphNode([{ name: `${tag.name} Communities`, path: canonicalPath }], pageUrl),
  collectionPageGraphNode({
    name: `${tag.name} Communities`,
    description: `Public communities tagged ${tag.name}. Browse, filter and discover.`,
    canonicalPath,
    items: communities,
  }),
]);
---

<DirectoryLayout
  title={tagPageTitle(tag.name)}
  heading={`${tag.name} Communities`}
  description={`Public communities tagged ${tag.name}. Browse, filter and discover.`}
  canonicalPath={canonicalPath}
  noindex={true}
  intro={`Communities tagged “${tag.name}”.`}
  count={`${communities.length} communities`}
  breadcrumbs={[{ label: tag.name }]}
  jsonLd={tagGraph}
>
  {
    category && (
      <p class="mb-4 text-sm text-stone-500">
        Part of the{' '}
        <a href={`/category/${category.slug}/`} class="font-medium text-blue-700 hover:text-blue-800">
          {category.name}
        </a>{' '}
        category.
      </p>
    )
  }

  {communities.length === 0 ? <EmptyState /> : <CommunityGrid communities={communities} />}
</DirectoryLayout>
