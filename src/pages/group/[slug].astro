---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PlatformBadge from '../../components/PlatformBadge.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';
import SafetyNotice from '../../components/SafetyNotice.astro';
import CommunityGrid from '../../components/CommunityGrid.astro';
import {
  getPublishedCommunities,
  getCommunityBySlug,
  getRelatedCommunities,
  getCategoryLabel,
  isCommunityIndexWorthy,
} from '../../lib/communities';
import { getCategoryBySlug, slugifyTag } from '../../config/categories';
import { getExam, getExamName } from '../../config/exams';
import { getPlatformById } from '../../config/platforms';
import { siteConfig } from '../../config/site';
import { formatDate } from '../../lib/dates';
import { languageLabel } from '../../lib/language';
import { communityTitle, communityDescription, breadcrumbJsonLd, jsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return getPublishedCommunities().map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const community = getCommunityBySlug(slug ?? '');
if (!community) return Astro.redirect('/404', 301);

const platformConfig = getPlatformById(community.platform);
const categoryConfig = getCategoryBySlug(community.category);
const primaryExam = community.exams?.[0] ? getExam(community.exams[0]) : null;
const related = getRelatedCommunities(community, 6);
const isIndexable = isCommunityIndexWorthy(community);
const marketLabels: Record<string, string> = {
  US: 'United States', UK: 'United Kingdom', CA: 'Canada', AU: 'Australia',
  NZ: 'New Zealand', IE: 'Ireland', 'global-english': 'Global English',
};

const checked = formatDate(community.lastCheckedAt);
const discovered = formatDate(community.discoveredAt);
const updated = formatDate(community.updatedAt);
const memberCountChecked = formatDate(community.memberCountCheckedAt);

const crumbs = [
  { label: categoryConfig?.name ?? 'Communities', href: `/category/${community.category}/` },
  ...(primaryExam ? [{ label: primaryExam.name, href: `/exam/${primaryExam.slug}/` }] : []),
  { label: community.title },
];

const crumbLd = [
  { name: categoryConfig?.name ?? 'Communities', path: `/category/${community.category}/` },
  ...(primaryExam ? [{ name: primaryExam.name, path: `/exam/${primaryExam.slug}/` }] : []),
  { name: community.title, path: `/group/${community.slug}/` },
];

const webPageLd = jsonLd({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: community.title,
  url: `/group/${community.slug}/`,
  isPartOf: { '@type': 'WebSite', name: siteConfig.name },
});
---

<BaseLayout
  title={communityTitle(community)}
  description={communityDescription(community)}
  canonicalPath={`/group/${community.slug}/`}
  noindex={!isIndexable}
  ogType="article"
  jsonLd={`${breadcrumbJsonLd(crumbLd)}\n${webPageLd}`}
>
  <div class="mx-auto w-full max-w-5xl px-4 py-8 sm:px-6">
    <Breadcrumbs items={crumbs} class="mb-4" />

    <header>
      <div class="flex flex-wrap items-center gap-2">
        <PlatformBadge platform={community.platform} size="md" />
        <VerificationBadge status={community.verificationStatus} size="md" />
        <StatusBadge status={community.linkStatus} size="md" />
        {community.featured && (
          <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2.5 py-0.5 text-sm font-medium text-amber-700">
            Featured
          </span>
        )}
      </div>
      <h1 class="mt-3 text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl">
        {community.title}
      </h1>
      <p class="mt-2 max-w-3xl leading-relaxed text-stone-600">
        {community.description ??
          `A publicly listed ${platformConfig?.name ?? community.platform} community categorized under ${getCategoryLabel(community.category)}.`}
      </p>
    </header>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a
        href={community.inviteUrl}
        target="_blank"
        rel="nofollow noopener noreferrer"
        class="btn-primary"
      >
        Visit Community
        <svg viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true">
          <path d="M11 3a1 1 0 1 0 0 2h2.59l-9.3 9.3a1 1 0 1 0 1.42 1.4L15 6.42V9a1 1 0 1 0 2 0V4a1 1 0 0 0-1-1h-5z" />
        </svg>
      </a>
      <a
        href={`/report/?id=${community.id}&slug=${community.slug}&url=${encodeURIComponent(community.inviteUrl)}`}
        class="btn-secondary"
      >
        Report Listing
      </a>
    </div>

    <SafetyNotice variant="study" class="mt-6" />

    <div class="mt-8 grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <section aria-labelledby="details-heading">
          <h2 id="details-heading" class="text-lg font-semibold text-stone-900">Details</h2>
          <dl class="mt-4 grid gap-x-6 gap-y-4 sm:grid-cols-2">
            <div>
              <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Category</dt>
              <dd class="mt-1"><CategoryBadge slug={community.category} size="md" /></dd>
            </div>
            <div>
              <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Platform</dt>
              <dd class="mt-1 text-sm text-stone-700">{platformConfig?.name}</dd>
            </div>
            {
              (community.exams ?? []).length > 0 && (
                <div>
                  <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Exams</dt>
                  <dd class="mt-1 flex flex-wrap gap-1.5">
                    {
                      community.exams.map((slug) => (
                        <a
                          href={`/exam/${slug}/`}
                          class="rounded-md bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-800 hover:bg-blue-100"
                        >
                          {getExamName(slug)}
                        </a>
                      ))
                    }
                  </dd>
                </div>
              )
            }
            {
              (community.targetMarkets ?? []).length > 0 && (
                <div>
                  <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Target markets</dt>
                  <dd class="mt-1 text-sm text-stone-700">
                    {community.targetMarkets.map((m) => marketLabels[m] ?? m).join(', ')}
                  </dd>
                </div>
              )
            }
            {
              (community.studyTypes ?? []).length > 0 && (
                <div>
                  <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Study type</dt>
                  <dd class="mt-1 text-sm capitalize text-stone-700">
                    {community.studyTypes.map((s) => s.replace(/-/g, ' ')).join(', ')}
                  </dd>
                </div>
              )
            }
            {
              community.certificationProvider && (
                <div>
                  <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Certification provider</dt>
                  <dd class="mt-1 text-sm text-stone-700">{community.certificationProvider}</dd>
                </div>
              )
            }
            {
              community.examLevel && (
                <div>
                  <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Exam level</dt>
                  <dd class="mt-1 text-sm text-stone-700">{community.examLevel}</dd>
                </div>
              )
            }
            {
              community.subcategory && (
                <div>
                  <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Subcategory</dt>
                  <dd class="mt-1 text-sm text-stone-700">{community.subcategory}</dd>
                </div>
              )
            }
            {
              community.language && (
                <div>
                  <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Language</dt>
                  <dd class="mt-1 text-sm text-stone-700">{languageLabel(community.language)}</dd>
                </div>
              )
            }
            {
              community.country && (
                <div>
                  <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Country</dt>
                  <dd class="mt-1 text-sm text-stone-700">{community.country}</dd>
                </div>
              )
            }
            {
              community.accessType && community.accessType !== 'unknown' && (
                <div>
                  <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Access</dt>
                  <dd class="mt-1 text-sm text-stone-700 capitalize">{community.accessType}</dd>
                </div>
              )
            }
            {
              community.communityType && community.communityType !== 'unknown' && (
                <div>
                  <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Community type</dt>
                  <dd class="mt-1 text-sm capitalize text-stone-700">{community.communityType}</dd>
                </div>
              )
            }
            {
              community.memberCount != null && (
                <div>
                  <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Members</dt>
                  <dd class="mt-1 text-sm font-medium text-stone-800">
                    {community.memberCount.toLocaleString()}
                    {memberCountChecked && (
                      <span class="font-normal text-stone-500"> (checked {memberCountChecked})</span>
                    )}
                  </dd>
                  {
                    community.memberCountSource && (
                      <dd class="mt-0.5 text-xs">
                        <a
                          href={community.memberCountSource}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-blue-700 hover:text-blue-800"
                        >
                          Source
                        </a>
                      </dd>
                    )
                  }
                </div>
              )
            }
            <div>
              <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Last checked</dt>
              <dd class="mt-1 text-sm text-stone-700">{checked ?? 'Not yet checked'}</dd>
            </div>
            <div>
              <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Discovered</dt>
              <dd class="mt-1 text-sm text-stone-700">{discovered}</dd>
            </div>
            {
              updated && (
                <div>
                  <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Last updated</dt>
                  <dd class="mt-1 text-sm text-stone-700">{updated}</dd>
                </div>
              )
            }
          </dl>
        </section>

        {
          community.tags.length > 0 && (
            <section aria-labelledby="tags-heading" class="mt-8">
              <h2 id="tags-heading" class="text-lg font-semibold text-stone-900">Tags</h2>
              <div class="mt-3 flex flex-wrap gap-2">
                {
                  community.tags.map((tag) => (
                    <a
                      href={`/tag/${slugifyTag(tag)}/`}
                      class="rounded-full border border-stone-200 bg-surface px-3 py-1 text-sm text-stone-600 hover:border-blue-300 hover:text-blue-700"
                    >
                      {tag}
                    </a>
                  ))
                }
              </div>
            </section>
          )
        }

        {
          community.sourceUrls.length > 0 && (
            <section aria-labelledby="sources-heading" class="mt-8">
              <h2 id="sources-heading" class="text-lg font-semibold text-stone-900">Source information</h2>
              <p class="mt-1 text-sm text-stone-500">
                Where this listing was publicly identified.
              </p>
              <ul class="mt-3 list-inside space-y-1 text-sm">
                {
                  community.sourceUrls.slice(0, 5).map((url) => (
                    <li class="truncate">
                      <a
                        href={url}
                        target="_blank"
                        rel="nofollow noopener noreferrer"
                        class="text-blue-700 hover:text-blue-800"
                      >
                        {url}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </section>
          )
        }

        {
          community.safetyFlags && community.safetyFlags.length > 0 && (
            <section aria-labelledby="flags-heading" class="mt-8">
              <h2 id="flags-heading" class="text-lg font-semibold text-stone-900">Review notes</h2>
              <p class="mt-2 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">
                This listing carries review flags ({community.safetyFlags.join(', ')}) that were
                noted during discovery or moderation. It has not been independently audited —
                verify claims before acting.
              </p>
            </section>
          )
        }
      </div>

      <aside class="space-y-4">
        <div class="card p-5">
          <h2 class="text-sm font-semibold text-stone-900">About this listing</h2>
          <ul class="mt-3 space-y-2 text-sm text-stone-600">
            <li>Verification: <VerificationBadge status={community.verificationStatus} /></li>
            <li>
              Discovered via:{' '}
              <span class="capitalize">{community.discoveryMethod.replace(/-/g, ' ')}</span>
            </li>
            {
              community.linkStatus === 'dead' && (
                <li class="rounded-md bg-rose-50 p-2 text-rose-700">
                  The invite appears unavailable. See related alternatives below.
                </li>
              )
            }
          </ul>
        </div>

        <div class="card bg-stone-50 p-5">
          <h2 class="text-sm font-semibold text-stone-900">Academic Integrity</h2>
          <p class="mt-2 text-xs leading-relaxed text-stone-600">
            StudyScout strictly prohibits brain dumps, leaked questions, and academic fraud.
            Read our <a href="/academic-integrity/" class="font-medium text-blue-700 hover:underline">Academic Integrity Policy</a> or <a href={`/report/?id=${community.id}&slug=${community.slug}`} class="font-medium text-blue-700 hover:underline">report a listing</a>.
          </p>
        </div>

        <SafetyNotice variant="external" />
      </aside>
    </div>

    {
      related.length > 0 && (
        <section aria-labelledby="related-heading" class="mt-12">
          <h2 id="related-heading" class="text-xl font-semibold text-stone-900">
            Related communities
          </h2>
          <p class="mt-1 text-sm text-stone-500">
            Matched deterministically by category, tags and platform.
          </p>
          <div class="mt-4">
            <CommunityGrid communities={related} />
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
