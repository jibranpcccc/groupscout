---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageTitle, canonicalUrl, graphJsonLd, breadcrumbGraphNode, contactPageGraphNode } from '../lib/seo';
import { siteConfig } from '../config/site';

const canonicalPath = '/contact/';
const pageUrl = canonicalUrl(canonicalPath);
const jsonLd = graphJsonLd([
  breadcrumbGraphNode([{ name: 'Contact', path: canonicalPath }], pageUrl),
  contactPageGraphNode(canonicalPath),
]);
---

<BaseLayout
  title={pageTitle('Contact Us: Corrections & Removals')}
  description={`Contact ${siteConfig.name} with listing corrections, removal requests, or directory feedback. Use our report form for broken links or policy issues.`}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <div class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
    <h1 class="text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl">Contact</h1>
    <p class="mt-2 text-stone-600">
      Questions, listing corrections, or removal requests? Send a message below and our
      editorial team will review it. For broken invites or policy violations, the{' '}
      <a href="/report/" class="text-blue-700 underline">listing report form</a> is usually faster.
    </p>

    <form
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/contact/?sent=1"
      class="card mt-8 space-y-5 p-6 sm:p-8"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden" aria-hidden="true">
        <label>
          Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" />
        </label>
      </p>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="contact-name" class="label">Name</label>
          <input id="contact-name" name="name" type="text" maxlength="120" class="field" />
        </div>
        <div>
          <label for="contact-email" class="label">Email *</label>
          <input id="contact-email" name="email" type="email" required maxlength="200" class="field" />
        </div>
      </div>
      <div>
        <label for="contact-message" class="label">Message *</label>
        <textarea id="contact-message" name="message" rows="6" required maxlength="3000" class="field"></textarea>
      </div>
      <button type="submit" class="btn-primary">Send message</button>
    </form>

    {
      Astro.url.searchParams.get('sent') === '1' && (
        <div role="status" class="mt-6 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800">
          Thanks. Your message was sent.
        </div>
      )
    }

    <div class="prose-static mt-10">
      <h2>What can you contact us about?</h2>
      <p>
        Use this form for general questions, editorial corrections, or community ownership requests.
        Choose the fastest path for your request:
      </p>
      <ul>
        <li>
          <strong>Listing corrections and exam updates:</strong> Let us know if a community covers
          additional exams, changed its platform focus, or needs updated public metadata.
        </li>
        <li>
          <strong>Community owner verification and removals:</strong> Server admins and channel
          owners can request <code>owner-confirmed</code> status or ask to remove a listing by
          verifying ownership from an official community channel.
        </li>
        <li>
          <strong>Broken links or academic integrity violations:</strong> Submit dead invites,
          spam, braindumps, or leaked question channels through the{' '}
          <a href="/report/">report form</a> so they enter the moderation queue under our{' '}
          <a href="/academic-integrity/">Academic Integrity Policy</a>.
        </li>
        <li>
          <strong>Suggest a new study community:</strong> Share active public{' '}
          <a href="/platform/telegram/">Telegram study groups</a> or{' '}
          <a href="/platform/discord/">Discord study servers</a> using the{' '}
          <a href="/submit/">community submission form</a>.
        </li>
      </ul>

      <h2>How does StudyGroupsHub handle inquiries?</h2>
      <p>
        Every contact message, correction, and removal request is reviewed manually by a human
        editor. We verify factual changes against public sources before updating the directory, as
        described in <a href="/how-we-verify/">How We Verify</a> and our{' '}
        <a href="/editorial-policy/">Editorial Policy</a>. For urgent takedown requests from
        verified community owners, please include the community slug and an official invite or
        admin channel link so we can confirm ownership promptly. Email addresses submitted through
        forms are used solely to process your request and are never published in our public
        dataset. See our <a href="/privacy/">Privacy Policy</a> for retention details.
      </p>
    </div>
  </div>
</BaseLayout>
