---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageTitle, breadcrumbJsonLd } from '../lib/seo';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title={pageTitle('Disclaimer')}
  description={`Disclaimer for ${siteConfig.name}.`}
  canonicalPath="/disclaimer/"
  jsonLd={breadcrumbJsonLd([{ name: 'Disclaimer', path: '/disclaimer/' }])}
>
  <div class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
    <h1 class="text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl">Disclaimer</h1>
    <p class="mt-2 text-sm text-stone-500">Last updated: August 2026</p>

    <div class="prose-static mt-6">
      <h2>A directory — nothing more</h2>
      <p>
        {siteConfig.name} is a directory of public study communities. We are{' '}
        <strong>not an exam provider, not a school or tutoring service, and not a
        certification authority</strong>. We do not administer, score, endorse or
        influence any exam, and we do not issue certificates or credentials.
      </p>

      <h2>Directory inclusion is not an endorsement</h2>
      <p>
        Inclusion in this directory does not mean we endorse, recommend, verify or vouch
        for any community, its administrators, its tutors, its members, its study
        materials or its content. A listing means we found a public community and recorded
        its invite link — nothing more.
      </p>

      <h2>No guarantees about test results</h2>
      <p>
        Nothing on this site guarantees any test result, score, pass outcome or
        certification. Any community, tutor or service claiming a guaranteed pass is
        making a claim we cannot verify and do not endorse. Your results depend on your
        own preparation, and no directory listing changes that.
      </p>

      <h2>No endorsement of unofficial exam materials</h2>
      <p>
        Study communities may share practice questions, notes or other materials that are
        not produced or approved by the relevant exam bodies. Listing such a community is
        not an endorsement of its materials, and we do not confirm that any shared
        material is accurate, current or authorized. Content that appears to be stolen or
        leaked exam material should be <a href="/report/">reported</a>, not trusted.
      </p>

      <h2>No affiliation</h2>
      <p>
        {siteConfig.name} is not affiliated with, sponsored by, or endorsed by Discord,
        Telegram, WhatsApp, or their parent companies. We are also not affiliated with the
        exam providers and certification bodies whose exams study communities prepare
        for — including but not limited to College Board, ACT, ETS, Pearson, CFA
        Institute, AWS (Amazon), Microsoft, Cisco, CompTIA, ISC2, PMI, and medical
        licensing boards. Exam names and trademarks belong to their respective owners and
        are used only to describe the focus of a community.
      </p>

      <h2>Accuracy</h2>
      <p>
        Listings are based on publicly available information at the time of discovery.
        Links break, communities change, exams change, and information becomes stale. We
        attempt to check links and record honest statuses, but we make no warranty that
        any listing is currently accurate.
      </p>

      <h2>External links</h2>
      <p>
        You may leave this site when visiting a community. We do not control external
        sites and are not responsible for their content or practices.
      </p>

      <h2>Reporting problems</h2>
      <p>
        If a listing is wrong, misleading, or harmful, please{' '}
        <a href="/report/">report it</a> so we can review it.
      </p>
    </div>
  </div>
</BaseLayout>
