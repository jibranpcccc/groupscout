---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageTitle } from '../../lib/seo';

/** Non-indexable success page for the submission form. */
---

<BaseLayout
  title={pageTitle('Submission Received')}
  description="Your community submission was received."
  canonicalPath="/submit/success/"
  noindex
>
  <div class="mx-auto w-full max-w-2xl px-4 py-20 text-center sm:px-6">
    <div class="mx-auto grid size-14 place-items-center rounded-full bg-emerald-100 text-emerald-700" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-7">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h1 class="mt-6 text-2xl font-bold text-stone-900">Submission received</h1>
    <p class="mt-3 text-stone-600">
      Thanks for contributing. Your submission is in the review queue — a human reviews
      everything before publication, so nothing appears automatically.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="btn-primary">Back to home</a>
      <a href="/submit/" class="btn-secondary">Submit another</a>
    </div>
  </div>
</BaseLayout>
