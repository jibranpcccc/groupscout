{
  "name": "community-directory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automated directory of public online communities (Telegram, WhatsApp, Discord) built with Astro.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "validate-data": "tsx scripts/data/validateSchema.ts",
    "discover": "tsx scripts/discover/index.ts",
    "validate-links": "tsx scripts/validate/index.ts",
    "data:stats": "tsx scripts/data/stats.ts",
    "approve": "tsx scripts/data/approve.ts",
    "auto-approve": "tsx scripts/data/autoApprove.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@google/genai": "^1.7.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.4.0",
    "dotenv": "^16.4.5",
    "tailwindcss": "^4.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
